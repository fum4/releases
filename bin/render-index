#!/bin/sh
# Render the bucket root's index.html and index.json from each package's latest release.
#
#   bin/render-index <state-dir> <out-dir>
#
# <state-dir>/<pkg>/ holds what bin/publish read from the bucket: latest (one tag line),
# SHA256SUMS (that tag's) and date (YYYY-MM-DD, when that SHA256SUMS was uploaded). A
# package with no latest is not released yet and is left out. Order, descriptions and
# source links come from ./packages. The page makes no external request: styles inline, one inline script
# (the install window's lights and the copy buttons, allowed by its CSP hash; the page works without it),
# fonts from the bucket's own _assets/.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=lib/common.sh
. "$ROOT/lib/common.sh"

[ $# -eq 2 ] || die "usage: render-index <state-dir> <out-dir>"
state=$1 out=$2
[ -d "$state" ] || die "no such state dir: $state"
mkdir -p "$out"
base=$(config_get RELEASES_BASE)

html_esc() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'; }
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# GitHub's mark (octicon mark-github, 16px grid), filled with currentColor.
GITHUB_MARK='<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>'

# The install window's three lights: the markup of nomadware.io's windowLightsMarkup
# (Nomadware.io apps/marketing src/scripts/window/window-lights.ts), named for the "sh code"
# window. Inert (aria-hidden, tabindex -1) until the page's script wires them.
light() { printf '<button type="button" class="window-light" data-window-action="%s" aria-label="%s: sh code" tabindex="-1">%s</button>' "$1" "$2" "$3"; }
GLYPHS='<svg class="window-glyph" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path class="window-glyph-enter" d="M2.8 2.8h2.8L2.8 5.6zM7.2 7.2H4.4L7.2 4.4z"/><path class="window-glyph-exit" d="M4.6 4.6H2L4.6 2zM5.4 5.4H8L5.4 8z"/></svg>'
LIGHTS="<span class=\"window-lights\" aria-hidden=\"true\">$(light close Close '')$(light minimize Minimize '')$(light maximize 'Full screen' "$GLYPHS")</span>"

# warn_unless_public URL: with gh available and signed in, warn when the repo is not public
# (the link would 404 for visitors). Never fails: CI may lack auth.
warn_unless_public() {
	command -v gh >/dev/null || return 0
	vis=$(gh repo view "${1#https://github.com/}" --json visibility --jq .visibility 2>/dev/null) || return 0
	[ "$vis" = PUBLIC ] || echo "render-index: warning: $1 is $vis, not public: its source link will 404 for visitors" >&2
}

html=$out/index.html.tmp json=$out/index.json.tmp
cards='' entries='' n=0
for pkg in $(pkg_names); do
	pkg_known "$pkg"
	[ -f "$state/$pkg/latest" ] || continue
	binary=$(pkg_field "$pkg" 2)
	desc=$(pkg_field "$pkg" 3)
	source=$(pkg_field "$pkg" 4)
	tag=$(sed -n 1p "$state/$pkg/latest")
	is_tag "$tag" || die "$pkg: latest is '$tag', not a vMAJOR.MINOR.PATCH tag"
	date=$(sed -n 1p "$state/$pkg/date")
	case $date in
	[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
	*) die "$pkg: date is '$date', not YYYY-MM-DD" ;;
	esac
	name_html="<a href=\"#$pkg\">$pkg</a>"
	if [ -n "$source" ]; then
		warn_unless_public "$source"
		name_html="<span class=\"name\">$name_html<a class=\"src\" href=\"$(html_esc "$source")\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Source on GitHub\">$GITHUB_MARK</a></span>"
	fi
	rel=$base/$pkg/$tag
	install="curl -fsSL $base/$pkg/install.sh | sh"
	links='' assets=''
	for t in $TARGETS; do
		asset=$binary-$t
		sha=$(awk -v a="$asset" '$2 == a || $2 == "*" a { print $1 }' "$state/$pkg/SHA256SUMS")
		[ -n "$sha" ] || continue
		case $sha in
		*[!0-9a-f]*) die "$pkg $tag: SHA256SUMS has a bad hash for $asset" ;;
		esac
		links="$links<a class=\"p\" href=\"$rel/$asset\">${t%-*}/${t#*-}</a>"
		[ -z "$assets" ] || assets="$assets,"
		assets="$assets{\"platform\":\"$t\",\"name\":\"$asset\",\"url\":\"$rel/$asset\",\"sha256\":\"$sha\"}"
	done
	[ -n "$assets" ] || die "$pkg $tag: SHA256SUMS lists no $binary-<os>-<arch> asset"
	cards="$cards<article class=\"pkg\" id=\"$pkg\">
<h2>$name_html <span class=\"meta\"><b>$tag</b> · $date</span></h2>
<p class=\"desc\">$(html_esc "$desc")</p>
<div class=\"window\" data-window=\"code\"><div class=\"window-frame\" data-window-frame><div class=\"window-bar\" data-window-bar>$LIGHTS<span class=\"window-label\">sh</span><button type=\"button\" class=\"copy\" data-copy=\"$(html_esc "$install")\" hidden>copy</button></div>
<div class=\"window-body\" data-window-body><pre class=\"term-body\"><code><span class=\"prompt\" aria-hidden=\"true\">\$ </span><span class=\"line\">$(html_esc "$install")</span></code></pre></div></div></div>
<p class=\"dl\"><span class=\"dl-label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4v11M7 10l5 5 5-5M5 20h14\"/></svg>Download</span>$links<a href=\"$rel/SHA256SUMS\">SHA256SUMS</a></p>
</article>
"
	[ "$n" = 0 ] || entries="$entries,"
	entries="$entries
    {\"name\":\"$pkg\",\"binary\":\"$binary\",\"description\":\"$(json_esc "$desc")\",\"version\":\"$tag\",\"date\":\"$date\",\"install\":\"$(json_esc "$install")\",\"sha256sums\":\"$rel/SHA256SUMS\",\"signature\":\"$rel/SHA256SUMS.sig\",\"assets\":[$assets]}"
	n=$((n + 1))
done
[ -n "$cards" ] || cards='<p class="desc">Nothing released yet.</p>'

{
	printf '{\n  "base": "%s",\n  "signing_key": "%s",\n  "packages": [%s\n  ]\n}\n' \
		"$base" "$(json_esc "$(cut -d' ' -f1,2 "$PUBKEY_FILE")")" "$entries"
} >"$json"

key=$(html_esc "$(cut -d' ' -f1,2 "$PUBKEY_FILE")")
# The CSP allows exactly the page's one inline script, by hash: the bytes between <script>
# and </script> (both on their own lines), hashed as the browser does, so editing the script
# in the template can never leave a stale hash behind.
script_hash=$(
	{
		printf '\n'
		awk '/^<script>$/ { on = 1; next } /^<\/script>$/ { on = 0 } on' "$ROOT/templates/index.html"
	} | openssl dgst -sha256 -binary | base64
) || die "cannot hash the page's script (openssl)"
printf '%s\n' "$cards" >"$out/cards.tmp"
sed -e "/@CARDS@/{r $out/cards.tmp" -e 'd' -e '}' -e "s|@KEY@|$key|" -e "s|@SCRIPT_HASH@|sha256-$script_hash|" \
	"$ROOT/templates/index.html" >"$html"
rm -f "$out/cards.tmp"
mv -f "$html" "$out/index.html"
mv -f "$json" "$out/index.json"
echo "rendered $out/index.html and index.json ($n packages)" >&2
